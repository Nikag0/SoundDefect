<Window x:Class="SoundDefect.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:local="clr-namespace:SoundDefect"
        mc:Ignorable="d"
        Title="SoundDefect" Height="600" Width="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#F3F3F3">
            <Button Content="📁 Добавить график" 
            Command="{Binding LoadFileCommand}" 
            Padding="12,6" 
            FontSize="14" 
            Cursor="Hand"
            FontWeight="SemiBold"/>

            <Button Content="Очистить графики" 
            Command="{Binding ClearCommand}" 
            Padding="12,6" 
            FontSize="14" 
            Cursor="Hand"
            FontWeight="SemiBold"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="120"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Background="#FAFAFA">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Верхняя часть: список сигналов -->
                <DockPanel Grid.Row="0" Margin="10">
                    <TextBlock Text="Сигналы:" DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,10" FontSize="13"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Signals}" VirtualizingStackPanel.IsVirtualizing="True" >
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4" VerticalAlignment="Center">

                                        <!-- Цветной маркер сигнала -->
                                        <Border Width="12" Height="12"
                                            CornerRadius="3"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding Brush}"
                                            BorderBrush="#CCCCCC" 
                                            BorderThickness="0.5"/>

                                        <!-- Чекбокс, привязанный к состоянию видимости -->
                                        <CheckBox IsChecked="{Binding IsVisible}" 
                                            Content="{Binding Name}" 
                                            FontSize="13" 
                                            Cursor="Hand"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Нижняя часть: режим отображения и способ нормализации -->
                <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Отображение:" FontWeight="Bold" Margin="0,0,0,8" FontSize="13"/>

                        <RadioButton Content="Исходные сигналы"
                                     GroupName="DisplayMode"
                                     IsChecked="{Binding ShowOriginal}"
                                     FontSize="13" Margin="0,2"/>

                        <RadioButton Content="Нормализованные"
                                     GroupName="DisplayMode"
                                     IsChecked="{Binding IsNormalized}"
                                     FontSize="13" Margin="0,2"/>

                        <TextBlock Text="Способ нормализации:" Margin="0,10,0,4" FontSize="12"
                                   IsEnabled="{Binding IsNormalized}"/>

                        <ComboBox ItemsSource="{Binding NormalizationMethods}"
                                  SelectedItem="{Binding SelectedNormalizationMethod}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsNormalized}"
                                  ToolTip="{Binding SelectedNormalizationMethod.Description}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E0E0E0"/>

            <ScottPlot:WpfPlot Name="MainPlot" Grid.Column="2" Margin="5"/>
        </Grid>

        <StatusBar Grid.Row="2" Background="#EAEAEA">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#333333"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
